release-evidence/
.venv-packaging/
__pycache__/
*.pyc
*.p12
*.pfx
*.key
*.pem
*.xcresult
.env
.env.*

# Template reference code is retained locally, never compiled or published.
archive/
TemplateApp/Download/
TemplateApp/Runtime/
TemplateApp/RuntimeDependencies/
